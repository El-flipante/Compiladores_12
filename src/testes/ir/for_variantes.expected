=== CODIGO INTERMEDIARIO (TRES ENDERECOS) ===
func main : int
    decl i : int
    decl s : int
    i = 0
    s = 0
  L1:
    t1 = i < 5
    if_false t1 goto L2
    t2 = s + i
    s = t2
    t3 = i + 1
    i = t3
    goto L1
  L2:
    i = 0
  L3:
    t4 = i > 3
    if_false t4 goto L5
    t5 = s + i
    return t5
  L5:
    t6 = i + 1
    i = t6
    goto L3
  L4:
    return 0
endfunc
=============================================
