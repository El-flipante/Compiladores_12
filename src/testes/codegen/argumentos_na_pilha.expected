=== CODIGO FINAL (ASSEMBLY RISC-V) ===
# Assembly RISC-V (RV32IM, ABI ilp32) gerado a partir do codigo intermediario
# Montar:  riscv64-unknown-elf-gcc -march=rv32im -mabi=ilp32 -nostdlib -static prog.s -o prog
# Executar: qemu-riscv32 ./prog   (codigo de saida = valor retornado por main)

    .text
    .globl _start
_start:
    jal ra, main
    li a7, 93
    ecall

    .globl f
f:
    addi sp, sp, -48
    sw ra, 44(sp)
    sw s0, 40(sp)
    addi s0, sp, 48
    sw a0, -12(s0)
    sw a1, -16(s0)
    sw a2, -20(s0)
    sw a3, -24(s0)
    sw a4, -28(s0)
    sw a5, -32(s0)
    sw a6, -36(s0)
    sw a7, -40(s0)
    lw t0, -40(s0)
    lw t1, 0(s0)
    add t0, t0, t1
    sw t0, -44(s0)
    lw t0, -44(s0)
    lw t1, 4(s0)
    add t0, t0, t1
    sw t0, -48(s0)
    lw a0, -48(s0)
.Lret_f:
    lw ra, -4(s0)
    mv sp, s0
    lw s0, -8(sp)
    ret

    .globl main
main:
    addi sp, sp, -32
    sw ra, 28(sp)
    sw s0, 24(sp)
    addi s0, sp, 32
    li a0, 1
    li a1, 2
    li a2, 3
    li a3, 4
    li a4, 5
    li a5, 6
    li a6, 7
    li a7, 8
    li t0, 9
    sw t0, 0(sp)
    li t0, 10
    sw t0, 4(sp)
    jal ra, f
    sw a0, -12(s0)
    lw a0, -12(s0)
.Lret_main:
    lw ra, -4(s0)
    mv sp, s0
    lw s0, -8(sp)
    ret
======================================
